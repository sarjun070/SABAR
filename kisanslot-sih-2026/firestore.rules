rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/farmers/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return isSignedIn() && callerRole() in ['officer', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    match /farmers/{userId} {
      allow read: if isSelf(userId) || isStaff();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /centres/{centreId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();

      allow update: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked', 'updatedAt'])
          && (
            request.resource.data.booked == resource.data.booked + 1
            || request.resource.data.booked == resource.data.booked - 1
          )
        );
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.farmerId == request.auth.uid || isStaff());
      allow delete: if false;
    }

    match /procurements/{procurementId} {
      allow read: if isSignedIn() && (resource.data.farmerId == request.auth.uid || isStaff());
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.farmerId == request.auth.uid || isStaff());
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.farmerId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && (request.resource.data.farmerId == request.auth.uid || isStaff());
      allow update: if isSignedIn() && resource.data.farmerId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}